# F3: vitrine Next.js 16 (storefront-next). Contexto: RAIZ do monorepo.
#   docker build -f atlas-storefront-dotnet/deploy/docker/Dockerfile.next \
#     -t atlas/storefront-web:TAG .
# Runtime: node + pnpm start (build SSR feito na imagem). Porta 3000.
FROM node:22-slim AS build
# BFF_URL é embutido no build: rewrites do Next são assados no routes-manifest
# (runtime não reavalia next.config). Para o cluster: --build-arg BFF_URL=http://atlas-gateway
ARG BFF_URL=http://127.0.0.1:5180
ENV BFF_URL=${BFF_URL}
# NEXT_PUBLIC_* também são assados no bundle client-side (login OIDC do buyer).
# Sem isso, o browser tenta Keycloak em 127.0.0.1 e o login nunca completa no deploy.
ARG NEXT_PUBLIC_KEYCLOAK_URL=https://keycloak.home.arpa
ARG NEXT_PUBLIC_KEYCLOAK_REALM=atlas
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=storefront
ENV NEXT_PUBLIC_KEYCLOAK_URL=${NEXT_PUBLIC_KEYCLOAK_URL}
ENV NEXT_PUBLIC_KEYCLOAK_REALM=${NEXT_PUBLIC_KEYCLOAK_REALM}
ENV NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=${NEXT_PUBLIC_KEYCLOAK_CLIENT_ID}
RUN corepack enable
WORKDIR /app
COPY atlas-storefront-dotnet/apps/storefront-next/package.json atlas-storefront-dotnet/apps/storefront-next/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY atlas-storefront-dotnet/apps/storefront-next/ ./
RUN pnpm exec next build

FROM node:22-slim
RUN corepack enable
WORKDIR /app
# node:22-slim corre como root por padrão, mas o HOME=/ é read-only em alguns
# runtimes; /tmp é sempre gravável (corepack/pnpm precisam de HOME).
ENV NODE_ENV=production HOME=/tmp
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/next.config.ts ./next.config.ts
ENV PORT=3000
EXPOSE 3000
CMD ["pnpm", "start"]
