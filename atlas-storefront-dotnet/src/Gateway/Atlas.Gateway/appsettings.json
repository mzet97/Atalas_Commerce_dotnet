{
  "ReverseProxy": {
    "Routes": {
      "catalog-owner": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/owner/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/owner/catalog"
          }
        ]
      },
      "inventory-owner": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/owner/inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/owner/inventory"
          }
        ]
      },
      "checkout-api": {
        "ClusterId": "checkout",
        "Match": {
          "Path": "/api/checkout/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/checkout"
          }
        ]
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5299"
          }
        }
      },
      "inventory": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5291"
          }
        }
      },
      "checkout": {
        "Destinations": {
          "d1": {
            "Address": "http://127.0.0.1:5297"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}