{
  "$schema": "http://json.schemastore.org/template",
  "author": "Atlas Commerce",
  "classifications": ["Atlas", "Web", "Service"],
  "identity": "Atlas.AspnetMicroservice",
  "name": "Atlas ASP.NET Core microservice (Clean/Hexagonal)",
  "shortName": "atlas-microservice",
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "service-name": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Atlas.Service",
