<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SDK C# gerado dos contratos .proto canônicos (ADR-0005: schema-first, buf lint/breaking).
    Consumido por referência durante o desenvolvimento local (M2); em produção, pacote NuGet
    versionado publicado por release deste repo (Atlas.Contracts.slnx).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Core.Api" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="..\..\contracts\proto\atlas\catalog\v1\catalog_owner.proto" GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\proto\atlas\inventory\v1\inventory_owner.proto" GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\proto\atlas\offers\v1\offers_owner.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
