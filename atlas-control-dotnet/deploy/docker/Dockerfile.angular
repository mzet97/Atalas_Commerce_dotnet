# F3: web Angular do Control servida por nginx na porta 4200 (conforme chart control-web).
# Contexto: RAIZ do monorepo.
#   docker build -f atlas-control-dotnet/deploy/docker/Dockerfile.angular \
#     -t atlas/control-web:TAG .
FROM node:22-slim AS build
WORKDIR /app
COPY atlas-control-dotnet/apps/control-angular/package.json atlas-control-dotnet/apps/control-angular/package-lock.json ./
RUN npm ci
COPY atlas-control-dotnet/apps/control-angular/ ./
RUN npm run build

# nginx unprivileged: roda como usuário nginx (charts impõem runAsNonRoot:1654);
# cache/pid vão para /tmp, porta 4200 (>1024) conforme chart control-web.
FROM nginxinc/nginx-unprivileged:alpine
COPY --from=build /app/dist/control-angular/browser/ /usr/share/nginx/html/
RUN printf 'server {\n  listen 4200;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 4200
